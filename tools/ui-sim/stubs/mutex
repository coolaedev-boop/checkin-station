#pragma once
// MinGW's GCC 6 has no std::mutex (no thread support). The simulator runs everything
// on one thread, so a lock that does nothing is enough for Inventory.cpp.
namespace std {
struct mutex {
  void lock() {}
  void unlock() {}
};
template <class M> class lock_guard {
 public:
  explicit lock_guard(M& m) : m_(m) { m_.lock(); }
  ~lock_guard() { m_.unlock(); }
  lock_guard(const lock_guard&) = delete;
  lock_guard& operator=(const lock_guard&) = delete;
 private:
  M& m_;
};
}  // namespace std
